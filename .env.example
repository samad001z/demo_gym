# The origin used for canonical URLs, the sitemap, OG tags and llms.txt.
#
# Leave unset on Vercel and the build falls back to the project's production
# domain (VERCEL_PROJECT_PRODUCTION_URL), which is correct for a fresh import.
# Set it explicitly once the real domain is attached.
NEXT_PUBLIC_SITE_URL=https://thefitnessedge.in
